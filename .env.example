# Part 21 Assurance OS - environment template
#
# Copy to .env and fill in real values. Never commit .env.
# The application has no in-memory fallback for operational data: without
# DATABASE_URL it refuses to start rather than serve fabricated records.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# MySQL-compatible connection string. TiDB Cloud Serverless and MySQL 8 both work.
# Include TLS parameters if your provider requires them.
DATABASE_URL="mysql://user:password@host:3306/database"

PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Regulatory snapshot ingestion (optional; required only to re-ingest eCFR)
# ---------------------------------------------------------------------------
# Ingestion is a deliberate operator action, never automatic at startup.
# Run: pnpm exec tsx scripts/ecfr-ingest-part21.ts
# Snapshots are pinned by source date and verified against the provision headings.

# ---------------------------------------------------------------------------
# Deadline supervision (Temporal)
# ---------------------------------------------------------------------------
# Leave PART21_AUTO_SUPERVISE unset to run the clock engine without a supervisor.
# The supervisor requires a reachable Temporal frontend and a running worker.
PART21_AUTO_SUPERVISE=false
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=part21-clocks
TEMPORAL_TLS=false
TEMPORAL_HEALTH_HOST=127.0.0.1
TEMPORAL_HEALTH_PORT=8090

# ---------------------------------------------------------------------------
# Model provider (grounded agent)
# ---------------------------------------------------------------------------
# The agent is grounded on database packets. Provider credentials are read
# server-side only and are never exposed to the browser.
# OPENAI_API_KEY / OPENAI_API_BASE are provided by the hosted sandbox runtime
# when present. Set them explicitly for self-hosting.
# OPENAI_API_KEY=
# OPENAI_API_BASE=
# PART21_LLM_MODEL=

# ---------------------------------------------------------------------------
# Muse / Studio connector
# ---------------------------------------------------------------------------
# Gateway mode merges the existing Studio OpenAPI with Part 21 operations.
# STUDIO_GATEWAY_MODE=merged
# STUDIO_UPSTREAM_BASE_URL=https://studio.example.com
# STUDIO_UPSTREAM_OPENAPI_URL=https://studio.example.com/api/v1/openapi.json
# STUDIO_PUBLIC_URL=https://part21.example.com
# Bearer tokens are validated against the Studio; they are never stored here.
# STUDIO_PART21_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# S3-compatible bucket with Object Lock, if you use protected evidence storage.
# S3_OBJECT_LOCK_BUCKET=
# Application-level settings encryption key for per-user connector secrets.
# PART21_SETTINGS_KEY=
